# Copy every line into Vercel → Project → Settings → Environment Variables (Production).
# Without the two VITE_SUPABASE_* lines the app opens in "modalità prova" (data only in the browser).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# SECRET: server only. Never put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Phone notifications (generated for you in .env.local)
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:onelinkrc@gmail.com

# Morning reminders (generated for you in .env.local)
CRON_SECRET=

# Address of the app, used in emails
APP_URL=https://geco-team.vercel.app

# Email fallback (optional): Resend → API Keys; the sender domain must be verified in Resend
RESEND_API_KEY=
EMAIL_FROM=Geco Team <team@gecocorporate.com>
